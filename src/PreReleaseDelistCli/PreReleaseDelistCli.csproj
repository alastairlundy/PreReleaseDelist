<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- LangVersion, Nullable and ImplicitUsings come from Directory.Build.props. -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>prerelease-delist</ToolCommandName>
        <RollForward>Major</RollForward>
        <!--
          This tool is NOT trim- or AOT-compatible. NuGet.Protocol deserialises repository signature
          resources with Newtonsoft.Json reflection, which the trimmer removes, so both a trimmed and a
          Native AOT publish build successfully and then fail at runtime with
          "Unable to find a constructor to use for type NuGet.Protocol.RepositoryCertificateInfo".
          Do not re-add IsTrimmable / IsAoTCompatible without a passing end-to-end run against a real
          NuGet feed. See docs/decisions/0001-no-trimming-or-native-aot.md.
        -->
        <AssemblyName>prerelease-delist</AssemblyName>
        <Title>PreReleaseDelist</Title>
        <Authors>Alastair Lundy</Authors>
        <Copyright>Copyright (c) Alastair Lundy 2026</Copyright>
        <RepositoryUrl>https://github.com/alastairlundy/PreReleaseDelist</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>delist, nuget,</PackageTags>
        <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageId>PreReleaseDelist</PackageId>
        <Description>De-list NuGet package versions programatically with ease.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>Initial Release</PackageReleaseNotes>
        <TargetFramework>net10.0</TargetFramework>
        <Version>0.1.0</Version>
        <PackageVersion>0.1.0</PackageVersion>
    </PropertyGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="PreReleaseDelistLib.FuzzTests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CliInvoke" />
      <PackageReference Include="DotMake.CommandLine"/>
      <PackageReference Include="Microsoft.Extensions.Configuration"/>
      <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables"/>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\PreReleaseDelistLib\PreReleaseDelistLib.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Localizations\Resources.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Localizations\Resources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Resources.resx</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\..\README.md">
        <Link>README.md</Link>
      </Content>
      <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
