<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>prerelease-delist</ToolCommandName>
        <RollForward>Major</RollForward>
        <IsAoTCompatible>true</IsAoTCompatible>
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <AssemblyName>prerelease-delist</AssemblyName>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>PreReleaseDelist</Title>
        <Authors>Alastair Lundy</Authors>
        <Copyright>Copyright (c) Alastair Lundy 2026</Copyright>
        <RepositoryUrl>https://github.com/alastairlundy/prerelease-delist</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>delist, nuget,</PackageTags>
        <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageId>PreReleaseDelist</PackageId>
        <Description>De-list NuGet package versions with ease from the Command Line.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>Initial Release</PackageReleaseNotes>
        <TargetFramework>net10.0</TargetFramework>
        <Version>0.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="PreReleaseDelistLib.FuzzTests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CliInvoke" />
      <PackageReference Include="DotMake.CommandLine"/>
      <PackageReference Include="Microsoft.Extensions.Configuration"/>
      <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables"/>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\PreReleaseDelistLib\PreReleaseDelistLib.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Localizations\Resources.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Localizations\Resources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Resources.resx</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\..\README.md">
        <Link>README.md</Link>
      </Content>
      <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
